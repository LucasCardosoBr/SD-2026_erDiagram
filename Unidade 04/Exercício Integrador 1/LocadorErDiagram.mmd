erDiagram
    FILIAL {
        int id_filial PK
        varchar nome
        varchar cidade
        char uf
        varchar telefone
        int matricula_gerente FK "NOT NULL"
    }

    FUNCIONARIO {
        int matricula PK
        varchar nome
        varchar cargo
        decimal salario
        date data_admissao
        int id_filial FK "NOT NULL"
    }

    CLIENTE {
        int id_cliente PK
        varchar nome
        varchar cpf
        varchar telefone
        varchar email "NULL"
    }

    CATEGORIA {
        int id_categoria PK
        varchar nome
        varchar descricao
    }

    VEICULO {
        varchar placa PK
        varchar modelo
        varchar marca
        int ano
        varchar cor
        decimal valor_diaria
        int id_filial FK "NOT NULL"
        int id_categoria FK "NOT NULL"
    }

    LOCACAO {
        int id_locacao PK
        date data_retirada
        date data_prevista
        date data_devolucao "NULL"
        varchar status
        int id_cliente FK "NOT NULL"
        int matricula_func FK "NOT NULL"
    }

    ITEM_LOCACAO {
        int id_locacao PK, FK "NOT NULL"
        varchar placa PK, FK "NOT NULL"
        decimal valor_diaria "NOT NULL"
    }

    PAGAMENTO {
        int id_pagamento PK
        decimal valor
        varchar forma_pagamento
        date data_pagamento
        int numero_parcela
        int id_locacao FK "NOT NULL"
    }

    %% Relacionamentos do Lógico
    FILIAL ||--|{ FUNCIONARIO : "lota"
    FUNCIONARIO ||--o| FILIAL : "gerencia (matricula_gerente)"
    FILIAL ||--|{ VEICULO : "mantém"
    CATEGORIA ||--|{ VEICULO : "classifica"
    CLIENTE ||--o{ LOCACAO : "realiza"
    FUNCIONARIO ||--o{ LOCACAO : "registra"
    LOCACAO ||--|{ PAGAMENTO : "gera"
    LOCACAO ||--|{ ITEM_LOCACAO : "possui"
    VEICULO ||--|{ ITEM_LOCACAO : "está em"